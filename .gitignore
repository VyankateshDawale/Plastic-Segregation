# Virtual environment
venv/

# Dataset (too large for git)
dataset/

# Training runs & model weights (too large for git)
runs/
*.pt
*.pkl
*.joblib

# Keep models/ folder docs; ignore weight binaries inside
models/**
!models/README.md
!models/.gitkeep

# Temp files
.pip_tmp/
.pip_cache/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Outputs
outputs/

# Local datasets / large archives (spectral)
FTIR-PLASTIC-c4/
ADVANCED_PLASTIC_FUSE/
ADVANCED_PLASTIC_FUSE.rar
*.rar
*.mat

# Keep exported paper tables; ignore huge npz if copied here
results/**/*.npz
!results/**/*.md
!results/**/*.json
!results/**/*.csv
